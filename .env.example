# Development settings only. Compose loads .env; Go reads process environment.
# PowerShell: copy this to .env, then dot-source scripts/env.ps1 before go run.
HTTP_ADDR=127.0.0.1:8080
HTTP_REQUEST_TIMEOUT=3s
STARTUP_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
DEPENDENCY_TIMEOUT=2s
MYSQL_ADDR=127.0.0.1:3306
MYSQL_USER=locallife
MYSQL_PASSWORD=locallife_dev
MYSQL_DATABASE=locallife
MYSQL_ROOT_PASSWORD=locallife_root_dev
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=3m
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
AUTH_DEV_CODES=false
AUTH_CODE_TTL=5m
AUTH_CODE_COOLDOWN=1m
AUTH_SESSION_TTL=30m
AUTH_MAX_CODE_ATTEMPTS=5
